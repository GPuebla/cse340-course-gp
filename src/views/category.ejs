<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <p><%= category.description %></p>
    <ul>
        <% projects.forEach(project => { %>
            <li>
                <span class="badge"><%= new Date(project.date).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric'
                }) %></span>
                <a class="project-title" href="/project/<%= project.project_id %>"><%= project.title %></a>
                <span class="project-org">
                    <a href="/organizations/<%= project.organization_id %>"><%= project.organization_name %></a>
                </span>
            </li>
        <% }) %>
    </ul>
</main>
<%- include('partials/footer') %>
