<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2><%= category.name %></h2>
    <p><%= category.description %></p>
    <ul>
        <% projects.forEach(project => { %>
            <li>
                <a class="project-title" href="/project/<%= project.project_id %>"><%= project.title %></a>
                <p><%= project.description %></p>
            </li>
        <% }) %>
    </ul>
</main>
<%- include('partials/footer') %>
