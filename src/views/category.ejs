<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>
            <%= category.name %>
        </h2>
        <p>
            <%= category.description %>
        </p>
        <ul>
            <% projects.forEach(project=> { %>
                <li><a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a></li>

                <% }) %>
        </ul>
        <% if (user && user.role_name === 'admin') { %>
        <div class="form-actions">
            <a href="/edit-category/<%= category.category_id %>" class="btn btn-primary">Edit Category</a>
        </div>
        <% } %>
    </main>
    <%- include('partials/footer') %>