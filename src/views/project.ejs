<%- include('partials/header') %>
<main>
    <a href="/projects" class="back-link">← All Projects</a>
    <h1><%= projectDetails.title %></h1>
    <div class="card project-detail">
        <dl class="detail-list">
            <div class="detail-row">
                <dt>Date</dt>
                <dd><span class="badge"><%= new Date(projectDetails.date).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric'
                }) %></span></dd>
            </div>
            <div class="detail-row">
                <dt>Location</dt>
                <dd><%= projectDetails.location %></dd>
            </div>
            <div class="detail-row">
                <dt>Organization</dt>
                <dd><a href="/organizations/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a></dd>
            </div>
            <div class="detail-row">
                <dt>Description</dt>
                <dd><%= projectDetails.description %></dd>
            </div>
        </dl>
    </div>
</main>
<%- include('partials/footer') %>
