<%- include('partials/header') %>
<main>
    <a href="/projects" class="back-link">← All Projects</a>
    <h1><%= projectDetails.title %></h1>
    <div class="card project-detail">
        <dl class="detail-list">
            <div class="detail-row">
                <dt>Date</dt>
                <dd><span class="badge"><%= new Date(projectDetails.date).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric'
                }) %></span></dd>
            </div>
            <div class="detail-row">
                <dt>Location</dt>
                <dd><%= projectDetails.location %></dd>
            </div>
            <div class="detail-row">
                <dt>Organization</dt>
                <dd><a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a></dd>
            </div>
            <div class="detail-row">
                <dt>Description</dt>
                <dd><%= projectDetails.description %></dd>
            </div>
            <div class="detail-row">
                <dt>Categories</dt>
                <dd>
                    <% if (categories.length > 0) { %>
                        <ul class="category-list">
                            <% categories.forEach(category => { %>
                                <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
                            <% }) %>
                        </ul>
                    <% } else { %>
                        <span>No categories assigned</span>
                    <% } %>
                </dd>
            </div>
        </dl>
    </div>

    <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
    
</main>
<%- include('partials/footer') %>
